# --- Application ---
APP_ENV=dev
APP_SECRET=ChangeMeBeforeProduction0000000000000000

# --- HTTP ---
HTTP_PORT=8000
HTTPS_PORT=8443
SERVER_NAME=:8000

# --- PostgreSQL ---
POSTGRES_DB=climalia
POSTGRES_USER=climalia
POSTGRES_PASSWORD=climalia
POSTGRES_PORT=5433
DATABASE_URL=postgresql://climalia:climalia@postgres:5432/climalia?serverVersion=16&charset=utf8

# --- JWT (lexik/jwt-authentication-bundle) ---
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=climalia-jwt-passphrase-change-me
JWT_TTL=3600

# --- CORS (front Vite) ---
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# --- Mailer (placeholder, non utilisé en phase 1) ---
MAILER_DSN=null://null
