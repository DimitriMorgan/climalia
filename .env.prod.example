# Climalia — production environment template
# Copier vers .env.prod et remplacer chaque <PLACEHOLDER> par une vraie valeur.
# .env.prod et .env.prod.local sont gitignored.
#
# Génération des secrets :
#   APP_SECRET       : openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -base64 32 | tr -d '/+=' | head -c 32
#   JWT_PASSPHRASE   : openssl rand -base64 32

# --- Application ---
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=<GENERATE-WITH-openssl-rand-hex-32>

# --- PostgreSQL ---
POSTGRES_DB=climalia
POSTGRES_USER=climalia
POSTGRES_PASSWORD=<STRONG-PASSWORD>

DATABASE_URL=postgresql://climalia:<STRONG-PASSWORD>@db:5432/climalia?serverVersion=16&charset=utf8

# --- JWT (lexik/jwt-authentication-bundle) ---
# Les chemins JWT_SECRET_KEY/JWT_PUBLIC_KEY sont définis dans compose.prod.yaml (/app/config/jwt/*.pem).
JWT_PASSPHRASE=<GENERATE-WITH-openssl-rand-base64-32>
JWT_TTL=3600

# --- CORS ---
CORS_ALLOW_ORIGIN=^https://climalia\.dimitrifruit\.dev$

# --- Symfony Routing : URL absolue utilisée en CLI / cache:warmup ---
DEFAULT_URI=https://climalia.dimitrifruit.dev

# --- Mailer (placeholder, non utilisé en phase 1) ---
MAILER_DSN=null://null
