# Caddyfile FrankenPHP pour Climalia (dev)
{
    # Active les modules FrankenPHP
    frankenphp
    # Pas de TLS auto en dev local
    auto_https off
    admin off
    order php_server before file_server
}

{$SERVER_NAME:localhost:8000} {
    log {
        output stderr
        format console
    }

    encode zstd br gzip

    # Médias uploadés : servis en statique uniquement, jamais exécutés par PHP
    # (parité avec la prod ; le dossier public/uploads est inscriptible).
    @uploads path /uploads/*
    handle @uploads {
        header X-Content-Type-Options nosniff
        root * /app/public
        file_server
    }

    # Reste : front controller Symfony via FrankenPHP
    handle {
        root * /app/public
        php_server {
            try_files {path} index.php
        }
    }
}
