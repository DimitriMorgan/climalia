# Caddyfile interne FrankenPHP (prod) — Climalia
# Ce serveur écoute sur :8000 derrière le Caddy externe du VPS qui fait le TLS.

{
	frankenphp
	auto_https off
	admin off
	order php_server before file_server
	# Journaux internes de Caddy/FrankenPHP en JSON, avertissements et erreurs seulement (Alloy → Loki).
	log {
		output stderr
		format json
		level WARN
	}
}

:8000 {
	# Pas de log d'accès ici : le Caddy partagé du VPS tient déjà le log d'accès complet (JSON), et
	# l'application écrit une ligne par requête API (contrat de logs).

	encode gzip zstd

	# Sonde de vivacité du conteneur (healthcheck Docker). L'ancienne interrogeait l'API admin de
	# Caddy (:2019), désactivée ici (`admin off`) : le conteneur restait « unhealthy » en permanence.
	handle /healthz {
		respond "ok" 200
	}

	# --- API Symfony : /api/* -> front controller index.php ---
	@api path /api /api/*
	handle @api {
		root * /app/public
		rewrite * /index.php
		php_server
	}

	# --- Médias uploadés : /uploads/* -> /app/public/uploads en statique ---
	@uploads path /uploads/*
	handle @uploads {
		header X-Content-Type-Options nosniff
		root * /app/public
		file_server
	}

	# --- SPA React : tout le reste -> /app/public/spa avec fallback index.html ---
	handle {
		root * /app/public/spa
		try_files {path} /index.html
		file_server
	}
}
